# {{ ansible_managed }}

[Unit]
Description=Voctomix cutlist
After=videoteam-voctocore.service
Requires=videoteam-voctocore.service
StartLimitIntervalSec=0
Conflicts=xlogout.target

ConditionPathIsReadWrite=/srv/video/{{ org }}/{{ show }}/dv/{{ room_name }}

[Service]
User={{ user_name }}
Group={{ user_name }}
Type=exec

ExecStart=/home/{{ user_name }}/voctomix-outcasts/generate-cut-list.py \
  --file=/srv/video/{{ org }}/{{ show }}/dv/{{ room_name }}/cutlist.log

KillMode=mixed
KillSignal=SIGINT

Restart=always
RestartSec=1s
StartLimitInterval=0

[Install]
WantedBy=default.target
